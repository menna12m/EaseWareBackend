{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ",
    "description": "Frequently asked questions (general or product-specific)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "blocks"
    },
    "product_tag": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["general", "sizing", "fabric", "care", "shipping"],
      "required": true,
      "default": "general"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
